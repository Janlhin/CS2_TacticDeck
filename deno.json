{
  "nodeModulesDir": "auto",
  "tasks": {
    "verify": "pwsh -NoLogo -NoProfile -File scripts/verify.ps1",
    "verify:fast": "pwsh -NoLogo -NoProfile -File scripts/verify.ps1 -NoExternal",
    "docs:check": "pwsh -NoLogo -NoProfile -File scripts/verify.ps1 -NoCargo",
    "dev": "deno run -A node_modules/vite/bin/vite.js",
    "typecheck": "deno run -A node_modules/typescript/bin/tsc --noEmit",
    "build:web": "deno run -A node_modules/typescript/bin/tsc --noEmit && deno run -A node_modules/vite/bin/vite.js build",
    "tauri": "deno run -A node_modules/@tauri-apps/cli/tauri.js",
    "app:dev": "deno run -A node_modules/@tauri-apps/cli/tauri.js dev",
    "app:build": "deno run -A node_modules/@tauri-apps/cli/tauri.js build",
    "build": "pwsh -NoLogo -NoProfile -File scripts/build.ps1",
    "test": "pwsh -NoLogo -NoProfile -File scripts/test.ps1",
    "test:web": "deno test -A tests",
    "hooks": "git config core.hooksPath .husky"
  }
}
