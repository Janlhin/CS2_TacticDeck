{
  "name": "cs2-tacticdeck",
  "version": "0.1.0",
  "private": true,
  "description": "本地优先的 CS2 多 POV 战术复盘工作台",
  "type": "module",
  "scripts": {
    "verify": "pwsh -NoLogo -NoProfile -File scripts/verify.ps1",
    "verify:fast": "pwsh -NoLogo -NoProfile -File scripts/verify.ps1 -NoExternal",
    "docs:check": "pwsh -NoLogo -NoProfile -File scripts/verify.ps1 -NoCargo",
    "build": "pwsh -NoLogo -NoProfile -File scripts/build.ps1",
    "test": "pwsh -NoLogo -NoProfile -File scripts/test.ps1",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.1",
    "markdown-link-check": "^3.15.0",
    "markdownlint-cli2": "^0.24.1",
    "remark-cli": "^12.0.1",
    "remark-validate-links": "^13.1.0"
  }
}
